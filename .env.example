# Copy this file to .env for local development.
# Never place real credentials in this example or commit your local .env.

# API runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATABASE_URL=sqlite:///./industrial_agent.db

# OpenAI-compatible service
# Ollama uses this default local endpoint. Set an API key only when your
# compatible service requires one.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=replace-with-installed-model
LLM_TIMEOUT_SECONDS=60

# Browser application. Vite uses its local /api development proxy by default;
# set this only for a different public API base URL. Never place a secret,
# credential, or private endpoint in a VITE_ variable.
VITE_API_BASE_URL=
