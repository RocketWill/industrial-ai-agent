# Copy this file to .env for local development.
# Never place real credentials in this example or commit your local .env.

# API runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATABASE_URL=sqlite:///./industrial_agent.db

# OpenAI-compatible service (optional until the LLM adapter is implemented)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-local-secret
LLM_MODEL=replace-with-compatible-model

# Browser application (used when the Vite application is implemented)
VITE_API_BASE_URL=http://127.0.0.1:8000
